##Version 1.0 - Stable with debug features added

import gc
import time
import board
import displayio
import terminalio
import adafruit_requests
import wifi
import socketpool
import ssl
import rgbmatrix
import framebufferio
import os
from adafruit_display_text import label
from adafruit_display_shapes.line import Line

# Release any previously configured displays
displayio.release_displays()

# Initialize the RGB Matrix
matrix = rgbmatrix.RGBMatrix(
    width=64, height=64, bit_depth=4,
    rgb_pins=[
        board.MTX_R1, board.MTX_G1, board.MTX_B1,
        board.MTX_R2, board.MTX_G2, board.MTX_B2
    ],
    addr_pins=[
        board.MTX_ADDRA, board.MTX_ADDRB, board.MTX_ADDRC,
        board.MTX_ADDRD, board.MTX_ADDRE
    ],
    clock_pin=board.MTX_CLK,
    latch_pin=board.MTX_LAT,
    output_enable_pin=board.MTX_OE
)
display = framebufferio.FramebufferDisplay(matrix, auto_refresh=True)

# Global variables for fetched data
latest_prices = {}
latest_history = {}
last_displayed_graphs = {}
last_fetched_time = 0
fetch_interval = 360  # Fetch every 6 minutes (360 seconds)

# Valid crypto symbols with their Kraken asset pairs
CRYPTO_SYMBOLS = {"BTC": "XXBTZUSD", "ETH": "XETHZUSD", "XRP": "XXRPZUSD"}


# Function to display a message on the screen
def display_message(messages, y_positions):
    display_group = displayio.Group()
    for index, message in enumerate(messages):
        message_label = label.Label(terminalio.FONT, text=message, color=0xFFFFFF, x=0, y=y_positions[index])
        display_group.append(message_label)
    display.root_group = display_group


# Display "Connecting" message on the screen
display_message(["Connecting"], [24])


# Read WiFi credentials from settings.toml
ssid = os.getenv("CIRCUITPY_WIFI_SSID")
password = os.getenv("CIRCUITPY_WIFI_PASSWORD")


# Scan for available WiFi networks
print("Scanning for available WiFi networks...")
networks = wifi.radio.start_scanning_networks()
available_networks = [network.ssid for network in networks]
wifi.radio.stop_scanning_networks()
print(f"Available networks: {available_networks}")


# Set up WiFi connection
print(f"Connecting to WiFi SSID: {ssid}")
try:
    wifi.radio.connect(ssid, password)
    print("Connected to WiFi")
    ip_address = wifi.radio.ipv4_address
    print(f"IP address: {ip_address}")
    # Display IP address on the screen broken up into three lines
    ip_parts = str(ip_address).split(".")
    display_message(["IP", f"{ip_parts[0]}.{ip_parts[1]}", f"{ip_parts[2]}.{ip_parts[3]}"], [8, 24, 40])
    time.sleep(5)
except Exception as e:
    print(f"Failed to connect to WiFi: {e}")
    display_message(["Failed to", "connect to WiFi"], [16, 32])
    time.sleep(5)


# Display "Loading" message on the screen
display_message(["Loading"], [24])


# Set up the network and requests
pool = socketpool.SocketPool(wifi.radio)
requests = adafruit_requests.Session(pool, ssl.create_default_context())

API_URL = "https://api.kraken.com/0/public/Ticker"
HISTORY_API_URL = "https://api.kraken.com/0/public/OHLC?pair={symbol}&interval=1440&since={start}"


# Function to format timestamps for Kraken
def format_timestamp(ts):
    return int(ts)


# Function to fetch price history for a cryptocurrency
def fetch_price_history(symbol):
    print(f"Fetching price history for {symbol}...")
    end_timestamp = format_timestamp(time.time())
    start_timestamp = format_timestamp(time.time() - (14 * 24 * 60 * 60))  # Fetch data for the past 2 weeks

    url = HISTORY_API_URL.format(symbol=symbol, start=start_timestamp)
    try:
        response = requests.get(url)
        if response.status_code != 200:
            raise Exception(f"HTTP Error {response.status_code}")
        data = response.json()

        if 'error' in data and data['error']:
            print(f"Error fetching price history for {symbol}: {data['error']}")
            return []

        result = data['result'][symbol]
        print(f"Fetched {len(result)} historical entries for {symbol}.")
        return [(entry[0], entry[4]) for entry in result]  # Use timestamp and closing price
    except Exception as e:
        print(f"Error fetching price history for {symbol}: {e}")
        return []


# Function to fetch the current prices
def fetch_crypto_prices():
    print("Fetching current crypto prices...")
    try:
        url = f"{API_URL}?pair={','.join(CRYPTO_SYMBOLS.values())}"
        response = requests.get(url)
        if response.status_code != 200:
            raise Exception(f"HTTP Error {response.status_code}")
        data = response.json()

        if 'error' in data and data['error']:
            print(f"Error fetching current prices: {data['error']}")
            return {}

        prices = {}
        for symbol, pair in CRYPTO_SYMBOLS.items():
            if pair in data['result']:
                prices[symbol] = float(data['result'][pair]['c'][0])
                print(f"Fetched price for {symbol}: ${prices[symbol]:.2f}")
            else:
                print(f"Skipping unknown asset pair: {pair}")
        return prices
    except Exception as e:
        print(f"Error fetching current prices: {e}")
        return {}


# Function to draw the price history graph
def draw_price_history_graph(prices, symbol):
    """Draw the price history graph only if prices are updated."""
    print(f"Drawing price history graph for {symbol}...")
    if not prices:
        print(f"No price history data for {symbol}")
        return None

    values = [float(price[1]) for price in prices]
    try:
        min_value = min(values)
        max_value = max(values)
        if min_value == max_value:
            normalized_values = [0.5] * len(values)
        else:
            range_values = max_value - min_value
            normalized_values = [(value - min_value) / range_values for value in values]
    except ValueError:
        print(f"Error: No values to plot for {symbol}")
        return None

    graph_group = displayio.Group()
    for i, value in enumerate(normalized_values):
        x_position = int(i * 64 / len(normalized_values))
        y_position = int(63 - (value * 32))
        line = Line(x_position, y_position, x_position, 63, color=0x00FF00)
        graph_group.append(line)

    print(f"Graph for {symbol} drawn successfully.")
    return graph_group


def update_display(symbol, price, history):
    print(f"Updating display for {symbol}...")

    if symbol in last_displayed_graphs:
        previous_history = last_displayed_graphs[symbol]["history"]
        if previous_history == history:
            # Data hasn't changed, but we still need to update the display focus
            print(f"No changes in data for {symbol}. Updating display focus.")
            display.root_group = last_displayed_graphs[symbol]["group"]
            return

    # Draw the new graph and update the display
    graph_group = draw_price_history_graph(history, symbol)
    if not graph_group:
        print(f"Skipping display update for {symbol} due to missing graph.")
        return

    # Create a new display group
    symbol_label = label.Label(terminalio.FONT, text=symbol, color=0xFFFFFF, x=0, y=8)
    price_label = label.Label(terminalio.FONT, text=f"${price:.2f}", color=0xFFFFFF, x=0, y=24)

    display_group = displayio.Group()
    display_group.append(symbol_label)
    display_group.append(price_label)
    display_group.append(graph_group)

    # Update the root display group
    display.root_group = display_group

    # Store the current graph and history for reuse
    last_displayed_graphs[symbol] = {"group": display_group, "history": history}

    print(f"Display updated for {symbol}.")


# Main loop for fetching and displaying data
while True:
    try:
        gc.collect()
        print(f"Free memory: {gc.mem_free()} bytes")

        current_time = time.monotonic()
        if current_time - last_fetched_time >= fetch_interval or not latest_prices:
            print("Fetching new data...")
            latest_prices = fetch_crypto_prices()
            for symbol in CRYPTO_SYMBOLS:
                latest_history[symbol] = fetch_price_history(CRYPTO_SYMBOLS[symbol])
            last_fetched_time = current_time
            print("Data fetch completed.")

        for symbol in CRYPTO_SYMBOLS:
            print(f"Displaying {symbol}...")
            if symbol in latest_prices and symbol in latest_history:
                update_display(symbol, latest_prices[symbol], latest_history[symbol])
                print(f"Finished displaying {symbol}. Cycling to the next coin...")
                time.sleep(30)
    except Exception as e:
        print(f"Error in main loop: {e}")
        time.sleep(5)
